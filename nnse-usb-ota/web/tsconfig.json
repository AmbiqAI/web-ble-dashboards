{
    "compilerOptions": {
      "target": "es6",                // or "es5" if you want older compatibility
      "module": "commonjs",           // or "esnext" if using modern bundlers
      "outDir": "./dist",             // compiled JS output directory
      "rootDir": "./",                // where your .ts files are
      "strict": true,
      "esModuleInterop": true
    },
    "include": ["./**/*.ts"]
  }
  