namespace web.usb;

enum UsbDataType : byte {
  NONE = 0,
  SET_SE_MODE = 1,
  SE_LATENCY = 2,
  OPUS_LATENCY = 3,
  AUDIO_DATA = 4,
  MODEL_DATA = 5,
  MODEL_METADATA = 6,
  MODEL_ACK = 7,
  MODEL_CONFIG = 8,
  MODEL_STATS = 9,
  MODEL_VALIDATION = 10,
  MODEL_VALIDATION_RESULT = 11,
  PERFORMANCE_STATS = 12,
  ERROR = 13
}

enum Platform : byte {
  APOLLO3 = 0,
  APOLLO4 = 1,
  APOLLO5 = 2
}

enum Command : byte {
  SEND_DATA = 0,
  CHECK_MAILBOX = 1,
  GET_DATA = 2,
  CHECK_HEARTBEAT = 3
}

enum ModelLocation : byte {
  SRAM = 0,
  MRAM = 1,
  PSRAM = 2,
  FLASH = 3
}

enum ArenaLocation : byte {
  SRAM = 0,
  MRAM = 1,
  PSRAM = 2
}

table ModelMetadata {
  total_size: uint32;
  chunk_size: uint32;
  model_type: string;
  model_location: ModelLocation;
  arena_location: ArenaLocation;
  max_arena_size: uint32;
  profile_enable: bool;
  profile_warmup: uint32;
  full_pmu_capture: bool;
  runs: uint32;
  random_data: bool;
}

table ModelConfig {
  prof_enable: uint32;
  total_input_tensor_bytes: uint32;
  total_output_tensor_bytes: uint32;
  profile_warmup: uint32;
  num_inputs: uint32;
  num_outputs: uint32;
  full_pmu_capture: uint32;
  input_tensor_byte_lengths: [uint32];
  output_tensor_byte_lengths: [uint32];
}

table PerformanceStats {
  computed_arena_size: uint32;
  computed_stat_buffer_size: uint32;
  captured_events: uint32;
  pmu_events_per_layer: uint32;
  platform: uint32;
  csv_header: string;
  stat_buffer: [uint32];
}

table ModelValidation {
  input_data: [ubyte];
  expected_output: [ubyte];
  run_number: uint32;
}

table ModelValidationResult {
  output_data: [ubyte];
  differences: [float32];
  validation_passed: bool;
  error_message: string;
}

table ErrorInfo {
  error_code: uint32;
  error_message: string;
  sequence: uint32;
}

table UsbPacket {
  platform: Platform;
  version: byte;
  type: UsbDataType;
  sequence: uint32;
  data: [ubyte];
}

file_identifier "USB1";